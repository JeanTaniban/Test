{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist/server",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "apps/server/src/**/*.ts",
    "packages/shared/src/**/*.ts"
  ],
  "exclude": [
    "apps/client/**",
    "tests/**"
  ]
}
